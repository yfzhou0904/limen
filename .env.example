# Required
ANTHROPIC_API_KEY=sk-ant-...
MISTRAL_API_KEY=...        # for PDF OCR
PURE_MD_API_KEY=pmd_...    # for URL → markdown

# Optional
ANTHROPIC_MODEL=claude-sonnet-4-6
ACCESS_CODE=               # set non-empty to enable HTTP basic auth
ADDR=:8080
DATA_DIR=./data
DB_PATH=                   # defaults to $DATA_DIR/data.db
